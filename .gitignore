# KitOps MLOps Integration Suite — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.env

# Jupyter
.ipynb_checkpoints/

# ML Artifacts (generated by training, not tracked in git)
model/
data/
inference/

# KitOps cache
.kit/

# macOS
.DS_Store
.AppleDouble

# IDE
.idea/
.vscode/
*.swp
*.swo

# Helm & Kubernetes temp files
*.tmp
*.bak

# Argo Workflow output
argo-out/

# Test output
.pytest_cache/
htmlcov/
.coverage
